{
    "env": {
        "es2022": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": ["@typescript-eslint"],
    "rules": {
        "indent": ["error", 4],
        "linebreak-style": ["error", "unix"],
        "max-len": [2, 120],
        "quotes": ["error", "single"],
        "semi": ["error", "always"],
        "space-in-parens": ["error", "never"],
        "keyword-spacing": ["error", {
            "before": true,
            "after": true
        }]
    }
}
